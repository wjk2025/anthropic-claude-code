# Microsoft Azure AD / Entra ID App Registration
# Create an app at https://portal.azure.com → Azure Active Directory → App registrations
O365_CLIENT_ID=your-client-id-here
O365_CLIENT_SECRET=your-client-secret-here
O365_TENANT_ID=your-tenant-id-here
O365_REDIRECT_URI=http://localhost:5000/auth/callback

# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=true

# Database (SQLite)
TASK_DB_PATH=task_tracker.db

# Email sync settings
POLL_INTERVAL=300
MAX_EMAILS_PER_POLL=50
